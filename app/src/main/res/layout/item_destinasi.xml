<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imgDestinasi"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="@string/default_destinasi_wisata"
        android:scaleType="centerCrop"
        android:background="@color/image_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tvNamaDestinasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nature_text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeskripsiDestinasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/nature_text_hint"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>