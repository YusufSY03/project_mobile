<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nature_lake_blue"
    android:padding="24dp">

    <!-- Tombol Lewati -->
    <Button
        android:id="@+id/btnLewati"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/transparent"
        android:text="@string/btn_lewati"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Kartu Gambar Ilustrasi -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIlustrasi2"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tvJudulTutorial2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnLewati"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/imgTutorial2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/tutorial_title_2"
            android:scaleType="centerCrop"
            android:src="@drawable/lembah_harau" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Judul Halaman -->
    <TextView
        android:id="@+id/tvJudulTutorial2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/merriweatherextrabold"
        android:gravity="center"
        android:text="@string/tutorial_title_2"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvDeskripsiTutorial2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardIlustrasi2" />

    <!-- Deskripsi Halaman -->
    <TextView
        android:id="@+id/tvDeskripsiTutorial2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/tutorial_desc_2"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvJudulTutorial2" />

</androidx.constraintlayout.widget.ConstraintLayout>